{
  "name": "MonUsineDeBoissons",
  "servePort": 34850,
  "globIgnorePaths": [
    "**/.gitkeep"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "$path": "src/first"
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      },
      "DevTools": {
        "$className": "Folder",
        "PreviewFactory": {
          "$path": "tools/build-map/preview-factory.luau"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "$path": "src/gui",
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": false
      }
    }
  }
}
